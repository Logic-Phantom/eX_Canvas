        <cl:formdata std:sid="f-data-0ddbc6ea" row="1" col="0"/>
        <cl:property name="title" value="암호화 데이터 송수신" type="string"/>
      </cl:udc>
      <cl:group std:sid="group-076cfdfc">
        <cl:formdata std:sid="f-data-2953f699" row="2" col="0"/>
        <cl:output std:sid="output-e07a120a" id="opt4" value="서브미션을 통해 요청/응답 데이터를 송수신합니다.">
          <cl:formdata std:sid="f-data-ad792e6f" row="0" col="0"/>
        </cl:output>
        <cl:output std:sid="output-03aa90f1" value="송수신 되는 데이터는 AES-CBC 암호화 알고리즘을 적용합니다.">
          <cl:formdata std:sid="f-data-e54b6d4a" row="1" col="0"/>
        </cl:output>
        <cl:output std:sid="output-9c020cbb" value="아래 조회영역의 조회 버튼을 클릭한 뒤, 개발자도구의 네트워크 탭에서 list.do 를 눌러 확인 할 수 있습니다.">
